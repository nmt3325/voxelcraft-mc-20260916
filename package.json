{
  "name": "voxelcraft-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoxelCraft - a Minecraft-like voxel sandbox in TypeScript + three.js",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "lint:ws": "pnpm -r lint",
    "test": "pnpm -r test",
    "assets": "pnpm --filter @voxelcraft/assets-gen run generate",
    "build": "pnpm run assets && pnpm --filter @voxelcraft/game run build",
    "dev": "pnpm --filter @voxelcraft/game run dev",
    "preview": "pnpm --filter @voxelcraft/game run preview",
    "test:e2e": "pnpm run build && pnpm --filter @voxelcraft/e2e run test:e2e",
    "bench": "pnpm --filter @voxelcraft/bench run bench",
    "size": "bash scripts/report-size.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
